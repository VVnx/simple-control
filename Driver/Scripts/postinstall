#!/bin/zsh
set -euo pipefail

driver_path='/Library/Audio/Plug-Ins/HAL/RC001 Remote Microphone.driver'
helper_path='/Applications/RC001-Viber HID Helper.app'
daemon_path='/Library/LaunchDaemons/com.wangxi.RC001Viber.HIDHelper.plist'
daemon_label='com.wangxi.RC001Viber.HIDHelper'

if [[ ! -d "$driver_path" ]]; then
  print -u2 "RC001 audio driver was not installed at the expected path"
  exit 1
fi

if [[ ! -x "$helper_path/Contents/MacOS/rc001-hid-helper" ]]; then
  print -u2 "RC001 HID helper was not installed at the expected path"
  exit 1
fi

if [[ ! -f "$daemon_path" ]]; then
  print -u2 "RC001 HID helper LaunchDaemon was not installed"
  exit 1
fi

/usr/sbin/chown -R root:wheel "$driver_path"
/bin/chmod -R go-w "$driver_path"
/usr/sbin/chown -R root:wheel "$helper_path"
/bin/chmod -R go-w "$helper_path"
/usr/sbin/chown root:wheel "$daemon_path"
/bin/chmod 644 "$daemon_path"

/bin/launchctl bootout "system/$daemon_label" >/dev/null 2>&1 || true

# bootout is asynchronous. During an upgrade launchd can keep the old job in
# its removal state briefly, and an immediate bootstrap then fails with
# EALREADY (reported by launchctl as error 5). Wait for the old job to
# disappear and retry bootstrap so normal upgrades do not fail on that race.
for attempt in {1..40}; do
  if ! /bin/launchctl print "system/$daemon_label" >/dev/null 2>&1; then
    break
  fi
  /bin/sleep 0.25
done

bootstrap_succeeded=0
for attempt in {1..40}; do
  if /bin/launchctl bootstrap system "$daemon_path" >/dev/null 2>&1; then
    bootstrap_succeeded=1
    break
  fi
  /bin/sleep 0.25
done

if [[ "$bootstrap_succeeded" -ne 1 ]]; then
  print -u2 "RC001 HID helper could not be registered after waiting for the previous service"
  exit 1
fi

/bin/launchctl enable "system/$daemon_label"
/bin/launchctl kickstart -k "system/$daemon_label"

# End any pre-upgrade bridge process that may still hold an unlinked audio
# ring. The user can reopen the newly installed menu-bar app after Installer
# finishes; launching a GUI app from this root script would use the wrong user.
/usr/bin/killall rc001-probe >/dev/null 2>&1 || true

# The system launchd domain rejects kickstart for this SIP-protected service on
# current macOS releases. A signal is sufficient; launchd starts it again. Do
# not fail an otherwise valid install if the process is between restarts.
/usr/bin/killall coreaudiod >/dev/null 2>&1 || true

exit 0
